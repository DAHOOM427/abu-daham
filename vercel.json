{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/auth.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/unlock.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/logout.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/catalog.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sports.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/email-login.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sports-detail.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/api/auth/?$",
      "dest": "/api/auth.js"
    },
    {
      "src": "^/api/unlock/?$",
      "dest": "/api/unlock.js"
    },
    {
      "src": "^/api/logout/?$",
      "dest": "/api/logout.js"
    },
    {
      "src": "^/api/catalog/?$",
      "dest": "/api/catalog.js"
    },
    {
      "src": "^/api/sports/?$",
      "dest": "/api/sports.js"
    },
    {
      "src": "^/api/email-login/?$",
      "dest": "/api/email-login.js"
    },
    {
      "src": "^/api/sports-detail/?$",
      "dest": "/api/sports-detail.js"
    },
    {
      "handle": "filesystem"
    }
  ]
}
